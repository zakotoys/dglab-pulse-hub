# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim AS build
WORKDIR /workspace

COPY package.json package-lock.json .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/workspace-ui/package.json packages/workspace-ui/package.json
RUN --mount=type=cache,id=dglab-pulse-hub-npm,target=/root/.npm \
  npm ci --workspace @dglab-pulse-hub/web --include-workspace-root=true \
    --ignore-scripts --no-audit --fund=false

COPY . .
RUN npm run web:build

FROM nginx:1.29-alpine AS web
COPY docker/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 CMD \
  wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
