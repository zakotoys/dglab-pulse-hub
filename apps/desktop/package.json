{
  "name": "@dglab-pulse-hub/desktop",
  "productName": "DGLab Pulse Hub",
  "version": "0.0.3",
  "private": true,
  "description": "DG-LAB .pulse waveform workbench",
  "author": "ZakoToys",
  "type": "module",
  "main": "./dist/main.js",
  "dependencies": {
    "@dglab-pulse-hub/application": "0.0.3",
    "@dglab-pulse-hub/contracts": "0.0.3",
    "@dglab-pulse-hub/core": "0.0.3",
    "@dglab-pulse-hub/workspace-ui": "0.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "electron": "^37.3.1"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/copy-desktop-assets.mjs && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "start": "electron dist/main.js",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
