{
  "name": "dglab-pulse-hub",
  "version": "0.1.0",
  "private": true,
  "description": "DG-LAB .pulse waveform workbench",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run desktop:assets && npm run desktop:main && npm run desktop:preload && npm run desktop:renderer",
    "typecheck": "tsc -b --pretty false",
    "pretest": "npm run typecheck",
    "test": "vitest run",
    "pretest:coverage": "npm run typecheck",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "npm run typecheck",
    "format:check": "git diff --check",
    "cli": "tsx apps/cli/src/index.ts",
    "api": "tsx apps/api/src/server.ts",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "desktop:assets": "node scripts/copy-desktop-assets.mjs",
    "desktop:main": "vite build --config apps/desktop/vite.main.config.ts",
    "desktop:preload": "vite build --config apps/desktop/vite.preload.config.ts",
    "desktop:renderer": "vite build --config apps/desktop/vite.config.ts",
    "desktop:package": "npm run build && npm --workspace @dglab-pulse-hub/desktop run package",
    "desktop:make": "npm run build && npm --workspace @dglab-pulse-hub/desktop run make",
    "corpus:report": "tsx scripts/corpus-report.ts",
    "corpus:verify": "tsx scripts/corpus-verify.ts"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "3.2.7",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.4.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  }
}
